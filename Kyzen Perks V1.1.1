--------------------------------------------------------------------
-- SETTINGS BUS
--------------------------------------------------------------------
local Listeners = {}
local function setSetting(key, value)
	Settings[key] = value
	if Listeners[key] then
		for _, f in ipairs(Listeners[key]) do f(value) end
	end
end
local function listen(key, f)
	Listeners[key] = Listeners[key] or {}
	table.insert(Listeners[key], f)
	f(Settings[key])
end


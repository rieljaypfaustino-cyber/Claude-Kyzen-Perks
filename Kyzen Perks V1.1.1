--------------------------------------------------------------------
-- ENTITY DISCOVERY
--------------------------------------------------------------------
local NPCs = {}
local function registerHumanoid(h)
	local m = h.Parent
	if m and m:IsA("Model") then NPCs[m] = true end
end
for _, d in ipairs(Workspace:GetDescendants()) do -- one-time scan
	if d:IsA("Humanoid") then registerHumanoid(d) end
end
Workspace.DescendantAdded:Connect(function(d)
	if d:IsA("Humanoid") then task.defer(registerHumanoid, d) end
end)

local function getMyRoot()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getParts(model)
	if not model or not model.Parent or not model:IsDescendantOf(Workspace) then return end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
		or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
	if not root or not root:IsA("BasePart") then return end
	local head = model:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then head = root end
	return hum, root, head
end

local function getAimPart(model)
	local _, root, head = getParts(model)
	if not root then return nil end
	if Settings.TargetPart == "Torso" then
		local t = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
		if t and t:IsA("BasePart") then return t end
		return root
	end
	return head
end

local function describe(model)
	local p = Players:GetPlayerFromCharacter(model)
	if p then
		local nm = (p.DisplayName ~= p.Name) and (p.DisplayName .. "  @" .. p.Name) or ("@" .. p.Name)
		return nm, "PLAYER"
	end
	return "NPC · " .. model.Name, "NPC"
end

local function isValid(model)
	if not model or model == LocalPlayer.Character then return false end
	local hum, root = getParts(model)
	if not hum then return false end
	if not Players:GetPlayerFromCharacter(model) and not Settings.IncludeNPC then return false end
	local myRoot = getMyRoot()
	if not myRoot then return false end
	return (root.Position - myRoot.Position).Magnitude <= Settings.TargetRange
end

local function getCandidates()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then list[#list + 1] = p.Character end
	end
	if Settings.IncludeNPC then
		for m in pairs(NPCs) do
			if not m.Parent then
				NPCs[m] = nil
			elseif m ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(m) then
				list[#list + 1] = m
			end
		end
	end
	return list
end

--------------------------------------------------------------------
-- SCORING (nearest player gets priority)
--------------------------------------------------------------------
local function scoreModel(model, ignoreFOV, isCurrent)
	local hum, root = getParts(model)
	if not hum then return nil end
	local myRoot = getMyRoot()
	local cam = Workspace.CurrentCamera
	if not myRoot or not cam then return nil end
	local part = getAimPart(model)
	if not part then return nil end

	local dist = (root.Position - myRoot.Position).Magnitude
	local toT = part.Position - cam.CFrame.Position
	if toT.Magnitude < 0.01 then return nil end

	local angle = math.deg(math.acos(math.clamp(cam.CFrame.LookVector:Dot(toT.Unit), -1, 1)))
	local vp = cam:WorldToViewportPoint(part.Position)
	local center = cam.ViewportSize / 2
	local pxDist = (vp.Z > 0) and (Vector2.new(vp.X, vp.Y) - center).Magnitude or math.huge
	local inCircle = pxDist <= Settings.FOVRadius

	if not ignoreFOV and not Settings.Detect360 and not inCircle then return nil end

	local nearScore = 1 / (1 + dist / 20) -- closer = much higher
	local angScore = 1 - angle / 180
	local circleScore = inCircle and (1 - pxDist / Settings.FOVRadius) or 0

	local mode = Settings.TargetMode
	local score
	if mode == "Nearest" then
		score = nearScore * 0.9 + angScore * 0.05 + circleScore * 0.05
	elseif mode == "Crosshair" then
		score = angScore * 0.6 + circleScore * 0.4
	else -- Smart (distance-dominant)
		score = nearScore * 0.7 + angScore * 0.15 + circleScore * 0.15
	end
	if isCurrent then score += MODE_CFG[mode].stab end
	return score
end


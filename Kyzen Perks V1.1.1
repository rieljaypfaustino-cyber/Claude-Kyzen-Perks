		LayoutOrder = nextOrder(parent), BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18),
		Font = Enum.Font.GothamBold, Text = "▍" .. text, TextSize = 11, TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = parent,
	})
end

local function row(parent, height)
	local r = new("Frame", {
		LayoutOrder = nextOrder(parent), Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = C.Panel, ZIndex = 8, Parent = parent,
	})
	decorate(r, 11, C.Accent, 0.8, 0.12, 12)
	return r
end

local function rowLabel(parent, text, sub)
	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(14, sub and 6 or 0),
		Size = UDim2.new(0.55, 0, 0, sub and 20 or 48), Font = Enum.Font.GothamBold, Text = text,
		TextSize = 14, TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9, Parent = parent,
	})
	if sub then
		new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 25), Size = UDim2.new(0.6, 0, 0, 14),
			Font = Enum.Font.Gotham, Text = sub, TextSize = 11, TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9, Parent = parent,
		})

local Tabs = {}
local currentTab

local function selectTab(i, instant)
	if currentTab == i then return end
	local prev = currentTab
	currentTab = i
	for j, t in ipairs(Tabs) do
		tween(t.Btn, 0.2, { BackgroundColor3 = (j == i) and C.Accent or C.Panel2 })
		tween(t.Btn, 0.2, { TextColor3 = (j == i) and Color3.new(1, 1, 1) or C.Muted })
	end
	tweenE(Indicator, 0.3, { Position = UDim2.fromOffset(4, Tabs[i].Btn.Position.Y.Offset + 7) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	if prev then
		local op = Tabs[prev].Page
		tween(op, 0.12, { GroupTransparency = 1 })
		task.delay(0.13, function()
			if currentTab ~= prev then op.Visible = false end
		end)
	end
	local np = Tabs[i].Page
	np.Visible = true
	np.Position = UDim2.fromOffset(0, instant and 0 or 14)
	np.GroupTransparency = instant and 0 or 1
	tween(np, 0.25, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
end


local function buildHighlight(model)
	local h = Instance.new("Highlight")
	h.Name = "TargetHighlight"
	h.Adornee = model
	h.FillColor = HL_COLORS[Settings.HighlightColor]
	h.OutlineColor = Color3.fromRGB(255, 255, 255)
	h.FillTransparency = 0.5
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = model
	return h
end

local function buildBillboard(model, head)
	local bb = Instance.new("BillboardGui")
	bb.Name = "TargetBillboard"
	bb.Adornee = head
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(210, 84)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.LightInfluence = 0
	bb.MaxDistance = math.huge
	bb.ResetOnSpawn = false

	local list = Instance.new("UIListLayout")
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Parent = bb

	local function label(name, size, font, color, height, order, text)
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, 0, height)
		l.Font = font
		l.TextSize = size
		l.TextColor3 = color
		l.TextStrokeTransparency = 0.3
		l.TextStrokeColor3 = Color3.new(0, 0, 0)
		l.LayoutOrder = order
		l.Text = text or ""
		l.Parent = bb
		return l
	end

	local title = label("Text", 30, Enum.Font.GothamBlack, HL_COLORS[Settings.HighlightColor], 34, 1, "TARGET")
	local nameL = label("Name", 16, Enum.Font.GothamBold, C.Text, 20, 2)
	local distL = label("Distance", 14, Enum.Font.GothamMedium, Color3.fromRGB(255, 235, 235), 18, 3)
	bb.Parent = model
	return bb, { Title = title, Name = nameL, Distance = distL }
end

local function updateBillboardText()
	local model = State.Current
	local refs = State.BillboardRefs
	if not model or not refs then return end
	local _, root = getParts(model)
	local myRoot = getMyRoot()
	if not root or not myRoot then return end
	local nameText = describe(model)
	if refs.Name.Text ~= nameText then refs.Name.Text = nameText end
	refs.Distance.Text = string.format("%.1f studs", (root.Position - myRoot.Position).Magnitude)
end

listen("HighlightColor", function(v)
	local col = HL_COLORS[v] or HL_COLORS.Red
	if State.Highlight then State.Highlight.FillColor = col end
	if State.BillboardRefs then State.BillboardRefs.Title.TextColor3 = col end
end)

--------------------------------------------------------------------
-- TARGET CONTROL
--------------------------------------------------------------------
local function clearTarget()
	if State.DiedConn then State.DiedConn:Disconnect() State.DiedConn = nil end
	if State.Highlight then State.Highlight:Destroy() State.Highlight = nil end
	if State.Billboard then State.Billboard:Destroy() State.Billboard = nil end
	State.BillboardRefs = nil
	State.Current = nil
end

local updateTarget

local function setTarget(model)
	clearTarget()
	local hum, _, head = getParts(model)
	if not hum then return end
	State.Current = model
	State.Highlight = buildHighlight(model)
	State.Billboard, State.BillboardRefs = buildBillboard(model, head)
	updateBillboardText()
	State.DiedConn = hum.Died:Connect(function()
		if State.Current == model then
			clearTarget()
			updateTarget()
		end
	end)
end

updateTarget = function()
	if not (Settings.TargetSystem or Settings.TargetLock or Settings.AimAssist) then
		if State.Current then clearTarget() end
		return
	end

	local cur = State.Current
	local curScore
	if cur then
		if isValid(cur) then
			curScore = scoreModel(cur, Settings.TargetLock, true)
		else
			clearTarget()
			cur = nil
		end
	end

	local best, bestScore
	for _, m in ipairs(getCandidates()) do
		if m ~= cur and isValid(m) then
			local s = scoreModel(m, false, false)
			if s and (not bestScore or s > bestScore) then best, bestScore = m, s end
		end
	end

	if best then
		if not cur or not curScore or bestScore > curScore + MODE_CFG[Settings.TargetMode].margin then
			setTarget(best)
		end
	elseif cur and not curScore then
		clearTarget()
	end
end

--------------------------------------------------------------------
-- CAMERA (fast turn, smooth ease-out, no roll, shortest 360° path)
--------------------------------------------------------------------
local function applyCamera(dt, model)
	local cam = Workspace.CurrentCamera
	local myChar = LocalPlayer.Character
	local myHead = myChar and (myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart"))
	local part = getAimPart(model)
	if not cam or not myHead or not part then return end

	local focus = myHead.Position
	local cf = cam.CFrame
	local dist = math.clamp((cf.Position - focus).Magnitude, 0, 40)

	local dir = part.Position - focus
	if dir.Magnitude < 0.05 then return end
	local dirU = dir.Unit

	local curLook = cf.LookVector
	local curYaw = math.atan2(-curLook.X, -curLook.Z)
	local curPitch = math.asin(math.clamp(curLook.Y, -1, 1))
	local gYaw = math.atan2(-dirU.X, -dirU.Z)
	local gPitch = math.asin(math.clamp(dirU.Y, -1, 1))

	local dYaw = (gYaw - curYaw + math.pi) % (2 * math.pi) - math.pi -- shortest turn
	local dPitch = gPitch - curPitch
	local angDeg = math.deg(math.sqrt(dYaw * dYaw + dPitch * dPitch))

	local base = SMOOTH_SPEED[Settings.Smoothness]
	local alpha
	if base == math.huge then
		alpha = 1
	else
		local speed = base
		if Settings.TargetLock then speed = math.max(speed, LOCK_MIN_SPEED) end
		speed *= 1 + math.clamp(angDeg / 40, 0, 4) -- farther = faster (fast 360° switch)
		alpha = 1 - math.exp(-speed * dt) -- frame-rate independent
		if Settings.TargetLock and angDeg < LOCK_SNAP_DEG then alpha = 1 end
	end

	local yaw = curYaw + dYaw * alpha
	local pitch = math.clamp(curPitch + dPitch * alpha, -1.4, 1.4)
	local rot = CFrame.fromOrientation(pitch, yaw, 0)

	local lookV = rot.LookVector
	local desired = focus - lookV * dist
	if dist > 1 then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { myChar }
		local res = Workspace:Raycast(focus, -lookV * dist, params)
		if res then desired = focus - lookV * math.max(res.Distance - 0.3, 0.5) end
	end
	cam.CFrame = CFrame.new(desired) * rot
end


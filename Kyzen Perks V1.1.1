	listen(key, function(v) btn.Text = tostring(v) end)
	btn.MouseButton1Click:Connect(function()
		local idx = table.find(options, Settings[key]) or 1
		setSetting(key, options[idx % #options + 1])
	end)
end

local function createSlider(parent, text, key, min, max, step, suffix)
	local r = row(parent, 62)
	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0.6, 0, 0, 32),
		Font = Enum.Font.GothamBold, Text = text, TextSize = 14, TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9, Parent = r,
	})
	local valueL = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.new(1, -114, 0, 0), Size = UDim2.fromOffset(100, 32),
		Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 9, Parent = r,
	})
	local hit = new("TextButton", {
		Position = UDim2.fromOffset(14, 32), Size = UDim2.new(1, -28, 0, 24),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 9, Parent = r,
	})
	local track = new("Frame", {
		Position = UDim2.new(0, 0, 0.5, -3), Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = C.Off, BorderSizePixel = 0, ZIndex = 10, Parent = hit,
	}, { corner(3) })
	local fillGrad = new("UIGradient", { Color = ColorSequence.new(C.Accent, C.Accent2) })
	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 11, Parent = track,
	}, { corner(3), fillGrad })
	idle({ G = fillGrad, Slide = true })
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = C.Text, BorderSizePixel = 0, ZIndex = 12, Parent = track,
	}, { corner(8) })
	local ks = stroke(C.Accent, 2, 0.2)
	ks.Parent = knob
	idle({ S = ks, B = 0.3, A = 0.3 })
	local ksc = Instance.new("UIScale")
	ksc.Parent = knob

	listen(key, function(v)
		local rel = (v - min) / (max - min)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, 0, 0.5, 0)
		valueL.Text = tostring(v) .. suffix
	end)

	local function setFromX(x)
		local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = min + (max - min) * rel
		setSetting(key, math.clamp(math.floor(v / step + 0.5) * step, min, max))
	end

	local dragging = false
	local scroller = parent
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			scroller.ScrollingEnabled = false
			tweenE(ksc, 0.15, { Scale = 1.3 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			scroller.ScrollingEnabled = true
			tweenE(ksc, 0.2, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end
	end)
end


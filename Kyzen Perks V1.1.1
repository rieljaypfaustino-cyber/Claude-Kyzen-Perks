local old = PlayerGui:FindFirstChild("KyzenPerksGui")
if old then old:Destroy() end

local function new(class, props, children)
	local inst = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do inst[k] = v end
	if children then for _, c in ipairs(children) do c.Parent = inst end end
	inst.Parent = parent
	return inst
end
local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function stroke(color, th, tr)
	return new("UIStroke", { Color = color, Thickness = th or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function tweenE(inst, t, props, style, dir)
	TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
end
local function tween(inst, t, props) tweenE(inst, t, props) end

local function sheen(inst, rot)
	return new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 165)),
		Rotation = rot or 90, Parent = inst,
	})
end

-- idle animation registry (stroke pulse + gradient spin/slide)
local Idles = {}
local function idle(o)
	o.P = math.random() * 6.283
	Idles[#Idles + 1] = o
end
RunService.Heartbeat:Connect(function()
	local t = os.clock()
	for i = #Idles, 1, -1 do
		local o = Idles[i]
		local ref = o.S or o.G
		if not ref or not ref.Parent then
			table.remove(Idles, i)
		else
			if o.S then o.S.Transparency = math.clamp(o.B + o.A * math.sin(t * 2.2 + o.P), 0, 1) end
			if o.G then
				if o.Spin then
					o.G.Rotation = (t * o.Spin + o.P * 57) % 360
				elseif o.Slide then
					o.G.Offset = Vector2.new(math.sin(t * 1.4 + o.P) * 0.35, 0)
				end
			end
		end
	end
end)

-- corner + sheen gradient + stroke + idle animation in one call
local function decorate(inst, r, strokeColor, base, amp, spin)
	corner(r).Parent = inst
	local g = sheen(inst, 90)
	local s = stroke(strokeColor or C.Accent, 1.2, base or 0.6)
	s.Parent = inst
	idle({ S = s, B = base or 0.6, A = amp or 0.15, G = g, Spin = spin or 14 })
	return s, g
end

-- hover / press / release-bounce animation
local function pressable(btn, hoverScale)
	hoverScale = hoverScale or 1.05
	local sc = Instance.new("UIScale")
	sc.Parent = btn
	local st = btn:FindFirstChildOfClass("UIStroke")
	local hovering = false
	btn.MouseEnter:Connect(function()
		hovering = true
		tween(sc, 0.12, { Scale = hoverScale })
	end)
	btn.MouseLeave:Connect(function()
		hovering = false
		tween(sc, 0.15, { Scale = 1 })
	end)
	btn.MouseButton1Down:Connect(function()
		tween(sc, 0.06, { Scale = 0.92 })
		if st then tween(st, 0.06, { Thickness = 3 }) end
	end)
	btn.MouseButton1Up:Connect(function()
		local target = (hovering and not UserInputService.TouchEnabled) and hoverScale or 1
		tweenE(sc, 0.22, { Scale = target }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		if st then tween(st, 0.2, { Thickness = 1.2 }) end
	end)
end

local function makeDraggable(handle, target, scaleObj, onClick)
	local dragging, moved, active, startInput, startPos = false, false, nil, nil, nil
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved, active = true, false, input
			startInput = input.Position
			startPos = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					if dragging and not moved and onClick then onClick() end
					dragging = false
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
			or (input.UserInputType == Enum.UserInputType.Touch and input == active)
		if not isMove then return end
		local d = input.Position - startInput
		if d.Magnitude > 6 then moved = true end
		if moved then
			local s = scaleObj and scaleObj.Scale or 1
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X / s, startPos.Y.Scale, startPos.Y.Offset + d.Y / s)
		end
	end)
end


local function makePage()
	local cg = new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false,
		GroupTransparency = 1, ZIndex = 7, Parent = Content,
	})
	local sc = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, ScrollBarImageColor3 = C.Accent, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 7, Parent = cg,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 12) }),
	})
	return cg, sc
end

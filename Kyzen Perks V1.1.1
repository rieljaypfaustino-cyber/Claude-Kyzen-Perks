local menuOpen = true
local function setMenu(v)
	menuOpen = v
	if v then
		Main.Scale.Scale = baseScale * 0.85
		Main.Visible = true
		tweenE(Main.Scale, 0.28, { Scale = baseScale }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	else
		tween(Main.Scale, 0.15, { Scale = baseScale * 0.85 })
		task.delay(0.16, function()
			if not menuOpen then Main.Visible = false end
		end)
	end
end
CloseBtn.MouseButton1Click:Connect(function() setMenu(false) end)


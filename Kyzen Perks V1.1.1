local selectAcc, billboardAcc = 0, 0

RunService.Heartbeat:Connect(function(dt)
	selectAcc += dt
	if selectAcc >= SELECT_INTERVAL then
		selectAcc = 0
		updateTarget()
	end
end)

RunService:BindToRenderStep("KyzenTargetCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local model = State.Current
	if not model then return end

	if State.Highlight then
		State.Highlight.FillTransparency = 0.55 + 0.22 * math.sin(os.clock() * 5)
	end

	billboardAcc += dt
	if billboardAcc >= 0.05 then
		billboardAcc = 0
		updateBillboardText()
	end

	if Settings.TargetLock or Settings.AimAssist then
		applyCamera(dt, model)
	end
end)


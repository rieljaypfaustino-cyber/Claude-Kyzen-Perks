local function createToggle(parent, text, sub, key, hint)
	local r = row(parent, 48)
	rowLabel(r, text, sub)
	if hint then
		new("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.new(1, -112, 0, 0), Size = UDim2.fromOffset(34, 48),
			Font = Enum.Font.GothamBold, Text = "[" .. hint .. "]", TextSize = 11, TextColor3 = C.Muted, ZIndex = 9, Parent = r,
		})
	end
	local track = new("TextButton", {
		Position = UDim2.new(1, -62, 0.5, -12), Size = UDim2.fromOffset(48, 24), BackgroundColor3 = C.Off,
		Text = "", AutoButtonColor = false, ZIndex = 9, Parent = r,
	})
	decorate(track, 12, C.Accent, 0.55, 0.3, 30)
	local knob = new("Frame", {
		Position = UDim2.fromOffset(3, 3), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = C.Text, ZIndex = 10, Parent = track,
	}, { corner(9) })
	pressable(track, 1.08)
	listen(key, function(on)
		tween(track, 0.18, { BackgroundColor3 = on and C.Accent or C.Off })
		tweenE(knob, 0.22, { Position = on and UDim2.fromOffset(27, 3) or UDim2.fromOffset(3, 3) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end)
	track.MouseButton1Click:Connect(function() setSetting(key, not Settings[key]) end)
end


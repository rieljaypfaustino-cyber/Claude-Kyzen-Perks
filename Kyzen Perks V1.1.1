local baseScale = 1
local function rescale()
	local vs = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	baseScale = math.clamp(math.min(vs.X / (MAIN_W + 40), vs.Y / (MAIN_H + 40)), 0.5, 1)
	Main.Scale.Scale = baseScale
	return vs
end

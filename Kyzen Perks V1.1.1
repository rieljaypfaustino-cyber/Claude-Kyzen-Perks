-- LIVE STATUS
--------------------------------------------------------------------
local statusAcc = 0
RunService.Heartbeat:Connect(function(dt)
	statusAcc += dt
	if statusAcc < 0.1 then return end
	statusAcc = 0

	local m = State.Current
	if m then
		local nm, kind = describe(m)
		StatusDot.BackgroundColor3 = C.Good
		StatusName.Text = nm
		StatusKind.Text = kind
		local _, root = getParts(m)
		local myRoot = getMyRoot()
		if root and myRoot then
			local d = (root.Position - myRoot.Position).Magnitude
			StatusDist.Text = string.format("%.1f studs  •  %s", d, Settings.TargetMode)
			BarFill.Size = UDim2.new(1 - math.clamp(d / Settings.TargetRange, 0, 1), 0, 1, 0)
		end
		CircleStroke.Color = C.Good
		Circle.BackgroundColor3 = C.Good
		CircleLabel.TextColor3 = C.Good
	else
		StatusDot.BackgroundColor3 = C.Off
		StatusName.Text = "No target"
		StatusKind.Text = ""
		StatusDist.Text = "Searching for nearest target..."
		BarFill.Size = UDim2.new(0, 0, 1, 0)
		CircleStroke.Color = C.Accent
		Circle.BackgroundColor3 = C.Accent
		CircleLabel.TextColor3 = C.Accent
	end
end)


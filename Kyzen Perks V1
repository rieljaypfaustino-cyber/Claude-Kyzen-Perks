--------------------------------------------------------------------
-- TARGET STATE CONTROL
--------------------------------------------------------------------
local function updateBillboardText()
	local target = State.Current
	local refs = State.BillboardRefs
	if not target or not refs then return end
	local _, _, root = getParts(target)
	local myRoot = getMyRoot()
	if not root or not myRoot then return end

	local disp, user = target.DisplayName, target.Name
	local nameText = (disp ~= user) and string.format("%s  @%s", disp, user) or ("@" .. user)
	if refs.Name.Text ~= nameText then
		refs.Name.Text = nameText
	end
	refs.Distance.Text = string.format("%.1f studs", (root.Position - myRoot.Position).Magnitude)
end

local function clearTarget()
	if State.DiedConn then
		State.DiedConn:Disconnect()
		State.DiedConn = nil
	end
	if State.Highlight then
		State.Highlight:Destroy()
		State.Highlight = nil
	end
	if State.Billboard then
		State.Billboard:Destroy()
		State.Billboard = nil
	end
	State.BillboardRefs = nil
	State.Current = nil
end

local updateTarget -- forward declaration

local function setTarget(player)
	clearTarget() -- old Highlight OFF + old Billboard OFF (walang stuck)
	local char, hum, _, head = getParts(player)
	if not char then return end

	State.Current = player
	State.Transition = TRANSITION_TIME
	State.Highlight = buildHighlight(char)
	State.Billboard, State.BillboardRefs = buildBillboard(char, head)
	updateBillboardText()

	State.DiedConn = hum.Died:Connect(function()
		if State.Current == player then
			clearTarget()
			updateTarget() -- immediate replacement
		end
	end)
end

updateTarget = function()
	if not (Settings.TargetLock or Settings.AimAssist) then
		if State.Current then clearTarget() end
		return
	end

	local cur = State.Current
	local curScore
	if cur then
		if isValid(cur) then
			curScore = scorePlayer(cur, Settings.TargetLock, true)
		else
			clearTarget()
			cur = nil
		end
	end

	local best, bestScore
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= cur and isValid(p) then
			local s = scorePlayer(p, false, false)
			if s and (not bestScore or s > bestScore) then
				best, bestScore = p, s
			end
		end
	end

	if best then
		if not cur or not curScore or bestScore > curScore + SWITCH_MARGIN then
			setTarget(best)
		end
	elseif cur and not curScore then
		clearTarget()
	end
end

--------------------------------------------------------------------
-- MAIN LOOPS
--------------------------------------------------------------------
local selectAcc, billboardAcc = 0, 0

RunService.Heartbeat:Connect(function(dt)
	selectAcc += dt
	if selectAcc >= SELECT_INTERVAL then
		selectAcc = 0
		updateTarget()
	end
end)

RunService:BindToRenderStep("KyzenTargetCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local target = State.Current
	if not target then return end

	-- Highlight pulse
	if State.Highlight then
		local t = os.clock()
		State.Highlight.FillTransparency = 0.55 + 0.22 * math.sin(t * 5)
		State.Highlight.OutlineTransparency = 0.05 + 0.1 * (0.5 + 0.5 * math.sin(t * 5))
	end

	-- Billboard (lightweight update)
	billboardAcc += dt
	if billboardAcc >= 0.05 then
		billboardAcc = 0
		updateBillboardText()
	end

	-- Camera: Target Lock / Aim Assist
	if not (Settings.TargetLock or Settings.AimAssist) then return end
	local char, _, _, _ = getParts(target)
	if not char then return end
	local part = getAimPart(char)
	local cam = Workspace.CurrentCamera
	if not part or not cam then return end

	local base = SMOOTH_SPEED[Settings.Smoothness]
	local speed = base
	if Settings.TargetLock and base ~= math.huge then
		speed = math.max(base, LOCK_MIN_SPEED)
	end
	if State.Transition > 0 then
		State.Transition -= dt
		if speed ~= math.huge then
			speed = math.min(speed, TRANSITION_SPEED)
		end
	end

	local goal = CFrame.lookAt(cam.CFrame.Position, part.Position)
	local alpha = (speed == math.huge) and 1 or (1 - math.exp(-speed * dt)) -- frame-rate independent
	cam.CFrame = cam.CFrame:Lerp(goal, alpha)
end)


-- Live status card
local statusAcc = 0
RunService.Heartbeat:Connect(function(dt)
	statusAcc += dt
	if statusAcc < 0.1 then return end
	statusAcc = 0
	local t = State.Current
	if t then
		StatusDot.BackgroundColor3 = C.Good
		StatusName.Text = (t.DisplayName ~= t.Name) and (t.DisplayName .. "  @" .. t.Name) or ("@" .. t.Name)
		local _, _, root = getParts(t)
		local myRoot = getMyRoot()
		if root and myRoot then
			StatusDist.Text = string.format("%.1f studs  •  %s mode", (root.Position - myRoot.Position).Magnitude, Settings.TargetMode)
		end
	else
		StatusDot.BackgroundColor3 = C.Off
		StatusName.Text = "No target"
		StatusDist.Text = (Settings.TargetLock or Settings.AimAssist) and "Searching..." or "Turn on Target Lock / Aim Assist"
	end
end)

-- Keybinds
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.RightShift then
		setMenu(not Main.Visible)
	elseif input.KeyCode == Enum.KeyCode.T then
		toggleSetters.TargetLock(not Settings.TargetLock)
	elseif input.KeyCode == Enum.KeyCode.G then
		toggleSetters.AimAssist(not Settings.AimAssist)
	end
end)

-- Cleanup
Players.PlayerRemoving:Connect(function(p)
	if State.Current == p then
		clearTarget()
		updateTarget()
	end
end)

-- Respawn of local player: reset so we never hold a stale target
LocalPlayer.CharacterAdded:Connect(function()
	clearTarget()
end)

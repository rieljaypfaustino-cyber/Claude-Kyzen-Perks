--------------------------------------------------------------------
-- HELPERS
--------------------------------------------------------------------
local function getMyRoot()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getParts(player)
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local head = char:FindFirstChild("Head")
	if not head then return end
	return char, hum, root, head
end

local function getAimPart(char)
	local head = char:FindFirstChild("Head")
	if Settings.TargetPart == "Head" and head then
		return head
	end
	if Settings.TargetPart == "Torso" then
		local t = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
		if t then return t end
	end
	return head or char:FindFirstChild("HumanoidRootPart")
end

--------------------------------------------------------------------
-- TARGET VALIDATION
--------------------------------------------------------------------
local function isValid(player)
	if not player or player == LocalPlayer or player.Parent ~= Players then return false end
	local char, _, root = getParts(player)
	if not char then return false end
	local myRoot = getMyRoot()
	if not myRoot then return false end
	return (root.Position - myRoot.Position).Magnitude <= Settings.TargetRange
end

--------------------------------------------------------------------
-- SMART SCORING
--------------------------------------------------------------------
local function scorePlayer(player, ignoreFOV, isCurrent)
	local char, _, root = getParts(player)
	if not char then return nil end
	local myRoot = getMyRoot()
	local cam = Workspace.CurrentCamera
	if not myRoot or not cam then return nil end

	local aimPart = getAimPart(char)
	if not aimPart then return nil end

	local dist = (root.Position - myRoot.Position).Magnitude
	local toTarget = aimPart.Position - cam.CFrame.Position
	if toTarget.Magnitude < 0.01 then return nil end

	local dot = math.clamp(cam.CFrame.LookVector:Dot(toTarget.Unit), -1, 1)
	local angle = math.deg(math.acos(dot))
	if not ignoreFOV and angle > Settings.FOV / 2 then return nil end

	local distScore = 1 - math.clamp(dist / Settings.TargetRange, 0, 1)
	local angScore = 1 - angle / 180

	local screenScore = 0
	local vp, onScreen = cam:WorldToViewportPoint(aimPart.Position)
	if onScreen then
		local vs = cam.ViewportSize
		local d = (Vector2.new(vp.X, vp.Y) - vs / 2).Magnitude
		screenScore = 1 - math.min(d / (vs.Magnitude / 2), 1)
	end

	local score
	if Settings.TargetMode == "Closest" then
		score = distScore
	elseif Settings.TargetMode == "Crosshair" then
		score = angScore * 0.8 + screenScore * 0.2
	else -- Smart
		score = distScore * 0.35 + angScore * 0.45 + screenScore * 0.20
	end

	if isCurrent then
		score += STABILITY_BONUS
	end
	return score
end


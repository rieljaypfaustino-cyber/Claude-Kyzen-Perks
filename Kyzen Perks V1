		Parent = r,
	})
	local track = new("Frame", {
		Position = UDim2.new(0, 0, 0.5, -3),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = C.Off,
		Parent = hit,
	}, { corner(3) })
	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.Accent, Parent = track }, {
		corner(3),
		new("UIGradient", { Color = ColorSequence.new(C.Accent, C.Accent2) }),
	})
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = C.Text,
		Parent = track,
	}, { corner(8), stroke(C.Accent, 2) })

	local function render()
		local rel = (Settings[key] - min) / (max - min)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, 0, 0.5, 0)
		valueL.Text = tostring(Settings[key]) .. suffix
	end
	local function setFromX(x)
		local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = min + (max - min) * rel
		Settings[key] = math.clamp(math.floor(v / step + 0.5) * step, min, max)
		render()
	end
	render()

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliderDragging = true
			Scroll.ScrollingEnabled = false
			setFromX(input.Position.X)
			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					sliderDragging = false
					Scroll.ScrollingEnabled = true
					conn:Disconnect()
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if sliderDragging and hit:IsDescendantOf(Gui) then
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				-- only the slider currently under the pointer reacts
				local p = input.Position
				local a, s = hit.AbsolutePosition, hit.AbsoluteSize
				if p.Y >= a.Y - 40 and p.Y <= a.Y + s.Y + 40 then
					setFromX(p.X)
				end
			end
		end
	end)
end

